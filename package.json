{
  "name": "emprestai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "prepare": "git config core.hooksPath .githooks",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "verificacoes:comparar": "node scripts/comparar-verificacoes.mjs",
    "imagens:preparar": "node --env-file-if-exists=.env skills/imagens-equipamentos/scripts/preparar.mjs",
    "imagens:revisar": "node skills/imagens-equipamentos/scripts/revisar.mjs",
    "imagens:enviar": "node skills/imagens-equipamentos/scripts/enviar.mjs",
    "imagens:enviar:producao": "node --env-file-if-exists=.env.producao skills/imagens-equipamentos/scripts/enviar.mjs --producao",
    "dados:popular": "node scripts/dados/popular.mjs",
    "dados:popular:producao": "node --env-file-if-exists=.env.producao scripts/dados/popular.mjs --producao"
  },
  "devDependencies": {
    "supabase": "3.1.0"
  }
}
