# Variáveis da raiz (scripts de dados e da skill imagens-equipamentos).
# Copie para `.env` e preencha. `.env` não vai para o Git.

# Chave gratuita do Pexels (https://www.pexels.com/api/). Usada por npm run imagens:preparar.
PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# PRODUÇÃO — NÃO coloque estas no `.env`. Crie um arquivo `.env.producao`
# (também fora do Git), só na máquina da pessoa que executa os passos de
# produção. Lido somente por npm run imagens:enviar:producao e
# npm run dados:popular:producao, que exigem terminal interativo.
#
# PRODUCAO_SUPABASE_URL=
# PRODUCAO_SUPABASE_SECRET_KEY=
# SENHA_PROFESSOR=
# ---------------------------------------------------------------------------
