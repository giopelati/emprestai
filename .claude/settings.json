{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Bash(npx supabase link:*)",
      "Bash(npx supabase db push:*)",
      "Bash(npx vercel:*)",
      "Bash(vercel:*)",
      "Bash(npm run imagens:enviar:producao:*)",
      "Bash(npm run dados:popular:producao:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guardas/bloquear-producao.mjs\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guardas/salvar-relatorio.mjs\""
          }
        ]
      }
    ]
  }
}
